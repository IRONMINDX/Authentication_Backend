# Copy this file to `.env` and fill in real values for your environment.
# Never commit a real `.env` file.

# --- General -----------------------------------------------------------
PROJECT_NAME="Auth Service"
ENVIRONMENT=development        # development | staging | production | test
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database ------------------------------------------------------------
# Async DSN — must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://auth_user:auth_password@localhost:5432/auth_db
DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# --- Security / JWT -------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_ROTATE=true

# --- Password policy --------------------------------------------------
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# --- Account lockout ---------------------------------------------------
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- Rate limiting -----------------------------------------------------
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_DEFAULT=100/minute

# --- CORS (comma-separated list of allowed origins) -----------------------
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Optional bootstrap superuser (create manually via a script/shell instead
# of relying on this in production; provided for local/dev convenience) ------
FIRST_SUPERUSER_EMAIL=
FIRST_SUPERUSER_PASSWORD=
